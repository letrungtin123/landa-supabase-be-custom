    "verify:tenant-data-quota:full": "tsx src/scripts/verify-tenant-data-quota.ts --mode=full-parity --require-worker-heartbeat",
    "wait:tenant-data-quota-worker": "tsx src/scripts/wait-tenant-data-quota-worker.ts",
    "verify:tenant-data-quota:release": "set NODE_ENV=production&& npm run wait:tenant-data-quota-worker -- --timeout-seconds=720 && npm run verify:tenant-data-quota -- --mode=fast --require-worker-heartbeat",
    "worker:tenant-data-quota": "tsx src/workers/tenant-data-quota.worker.ts",
    "worker:news-assets-cleanup": "tsx src/workers/news-assets-cleanup.worker.ts",
