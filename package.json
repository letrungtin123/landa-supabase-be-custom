{
  "name": "landa-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-local-dev.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "pm2:prod": "pm2 startOrReload ecosystem.config.cjs --env production --update-env",
    "pm2:save": "pm2 save",
    "deploy:prod": "npm run build && npm run pm2:prod && npm run verify:tenant-data-quota:release && npm run pm2:save",
    "seed": "tsx src/scripts/seed.ts",
    "reconcile:deletion-storage": "tsx src/scripts/reconcile-deletion-storage.ts",
