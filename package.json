    "test:report-pdf": "tsx --test --test-force-exit src/modules/ai-chatbot/report-ai-model.test.ts src/modules/ai-chatbot/report-locale-text.logic.test.ts src/modules/ai-chatbot/report-insights.logic.test.ts src/modules/ai-chatbot/report-pdf-narrative.logic.test.ts src/modules/ai-chatbot/report-pdf-template.test.ts src/modules/ai-chatbot/report-pdf-export.logic.test.ts src/modules/ai-chatbot/report-pdf.controller.test.ts src/modules/ai-chatbot/report-pdf-renderer.service.test.ts src/modules/ai-chatbot/report-pdf-renderer.smoke.test.ts",
    "report-pdf:samples": "tsx src/scripts/render-report-pdf-samples.ts",
    "test:deletion": "tsx --test src/modules/deletion/storage-manifest.logic.test.ts",
    "verify:audit-i18n": "tsx src/scripts/verify-audit-event-i18n.ts",
    "verify:audit-event-usage": "tsx src/scripts/verify-audit-event-usage.ts",
    "transfer:help-docs": "tsx src/scripts/transfer-help-docs-between-supabase.ts"
