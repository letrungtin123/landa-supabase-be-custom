# ═══════════════════════════════════════════════════════════════
# LANDA Backend — Environment Variables
# Copy file này thành .env rồi điền giá trị
# KHÔNG commit .env vào Git!
# ═══════════════════════════════════════════════════════════════

# ── Server ──
NODE_ENV=development
PORT=3001

# ── Database (Supabase PostgreSQL) ──
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Redis (optional - backend falls back to DB if unavailable)
REDIS_URL=redis://landa_be:change-me@127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=2000

# ── JWT ──
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SSO_CONFIG_ENCRYPTION_KEY=replace-with-32-plus-random-characters

# ── Bcrypt ──
BCRYPT_SALT_ROUNDS=12

# ── CORS ──
CORS_ORIGIN=http://localhost:5173
