# ═══════════════════════════════════════════════════════════════
# LANDA Backend — Environment Variables
# Copy file này thành .env rồi điền giá trị
# KHÔNG commit .env vào Git!
# ═══════════════════════════════════════════════════════════════

# ── Server ──
NODE_ENV=development
PORT=3001
RUNTIME_LANE=default
# Optional comma-separated UUIDs. Use an allowlist for localhost DEV and the
# matching denylist in the always-on DEMO runtime when sharing one database.
RUNTIME_TENANT_ALLOWLIST=
RUNTIME_TENANT_DENYLIST=
RUNTIME_GLOBAL_MAINTENANCE_ENABLED=true
# Use 127.0.0.1 when a production Nginx gateway owns public traffic. Keep the
# default for existing direct/local deployments.
BIND_HOST=0.0.0.0
TRUST_PROXY_HOPS=0
# Production only: comma-separated proxy networks that are allowed to supply
# forwarded client addresses. Prefer this exact allowlist over a hop count when
# the API is behind a CDN and a gateway. Never use `true` or a broad network.
# When set it replaces TRUST_PROXY_HOPS. Recommended production value: loopback
# (the frontend servers on this host append the client address), the gateway's
# own address if it runs on another host or in Docker, and the Cloudflare ranges
# (check https://www.cloudflare.com/ips/ before deploying):
# loopback,173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,
# 141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,
# 197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,
# 172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,
# 2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
TRUSTED_PROXY_CIDRS=

# Auth rate limits per 15-minute window (Redis-shared when Redis is available).
# The per-IP sign-in limit keeps the historical 20.
AUTH_LOGIN_IP_MAX_ATTEMPTS=20
# Failed sign-ins per typed account name/email.
AUTH_LOGIN_ACCOUNT_MAX_FAILURES=10
# Session refreshes per refresh token.
AUTH_REFRESH_TOKEN_MAX_ATTEMPTS=10
AUTH_PASSWORD_CHANGE_MAX_ATTEMPTS=10
# One-time sign-in links (create + use) and profile updates, per user or IP.
AUTH_ACCOUNT_ACTION_MAX_ATTEMPTS=30

# ── Protected infrastructure — fill locally, keep blank in Git ──
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RABBITMQ_URL=
RABBITMQ_QUEUE_PREFIX=

# Redis (optional - backend falls back to DB if unavailable)
REDIS_URL=
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT_MS=2000
SMTP_TLS_REJECT_UNAUTHORIZED=true
EMAIL_OUTBOX_WORKER_ENABLED=true
EMAIL_OUTBOX_INLINE_WORKER_ENABLED=true
EMAIL_OUTBOX_QUEUE=LANDA_EMAIL_OUTBOX
EMAIL_OUTBOX_INTERVAL_MS=15000
EMAIL_OUTBOX_BATCH_SIZE=25
EMAIL_OUTBOX_CLAIM_BATCH_SIZE=25
EMAIL_OUTBOX_CONCURRENCY=3
EMAIL_OUTBOX_TENANT_CONCURRENCY=2
EMAIL_OUTBOX_TICK_BUDGET_MS=45000
EMAIL_OUTBOX_SESSION_MAX_MESSAGES=20
EMAIL_OUTBOX_SENT_RETENTION_DAYS=30
EMAIL_OUTBOX_RETENTION_BATCH_SIZE=1000
EMAIL_OUTBOX_WAKE_DEBOUNCE_MS=500
EMAIL_OUTBOX_RABBIT_PREFETCH=50
EMAIL_OUTBOX_TENANT_FAILURE_THRESHOLD=3
EMAIL_OUTBOX_TENANT_COOLDOWN_MS=300000
EMAIL_OUTBOX_TENANT_MAX_COOLDOWN_MS=1800000

# Tenant data quota reconciliation. Production uses the dedicated PM2 worker;
# leave false for an API-only local process.
TENANT_DATA_QUOTA_WORKER_ENABLED=false
TENANT_DATA_QUOTA_WORKER_HEARTBEAT_INTERVAL_MS=30000
TENANT_DATA_QUOTA_WORKER_POLL_INTERVAL_MS=15000
TENANT_DATA_QUOTA_WORKER_STANDBY_RETRY_MS=30000
TENANT_DATA_QUOTA_WORKER_PAGE_SIZE=500
TENANT_DATA_QUOTA_WORKER_MAX_TENANTS_PER_CYCLE=1
TENANT_DATA_QUOTA_WORKER_MAX_PAGES_PER_CLAIM=100
TENANT_DATA_QUOTA_WORKER_LEASE_SECONDS=120
TENANT_DATA_QUOTA_WORKER_MAX_SLICE_MS=60000
TENANT_DATA_QUOTA_WORKER_DATABASE_SNAPSHOT_TIMEOUT_MS=600000
TENANT_DATA_QUOTA_WORKER_RETRY_BASE_SECONDS=30
TENANT_DATA_QUOTA_WORKER_RETRY_MAX_SECONDS=3600

# Durable Knowledge Base operation worker. PostgreSQL claims jobs safely when
# more than one backend replica is running; do not run a separate manual job.
KB_OPERATION_WORKER_ENABLED=true
KB_OPERATION_WORKER_POLL_INTERVAL_MS=10000
KB_OPERATION_WORKER_BATCH_SIZE=24
KB_OPERATION_WORKER_CONCURRENCY=4
KB_OPERATION_WORKER_LEASE_SECONDS=300
KB_OPERATION_WORKER_MAX_ATTEMPTS=12
KB_OPERATION_WORKER_RETRY_BASE_SECONDS=30
KB_OPERATION_WORKER_RETRY_MAX_SECONDS=3600
# DB-backed recovery for a committed KB restore whose RabbitMQ message was lost.
KB_RESTORE_RECOVERY_POLL_INTERVAL_MS=30000

# Resumable cross-course outline transfer. Production starts the dedicated PM2
# worker; API-only/local processes should leave this disabled.
COURSE_OUTLINE_TRANSFER_WORKER_ENABLED=false
COURSE_OUTLINE_TRANSFER_WORKER_POLL_INTERVAL_MS=10000

# Self-built AI/RAG. AI_SECRET_ENCRYPTION_KEY must be a private random secret in production.
# Legacy v1 encrypted keys can still be read, but new provider keys require this secret.
AI_SECRET_ENCRYPTION_KEY=
AI_RAG_SERVICE_URL=http://127.0.0.1:8010
AI_RAG_SERVICE_TOKEN=
AI_RAG_SERVICE_HMAC_KEY_ID=
AI_RAG_SERVICE_HMAC_SECRET=
AI_RAG_REQUEST_TIMEOUT_MS=600000
AI_RAG_INDEX_REQUEST_TIMEOUT_MS=900000
# Idle keep-alive of reused sockets to the AI service; keep it below the AI/nginx keep-alive (75 s).
AI_RAG_HTTP_KEEP_ALIVE_IDLE_MS=30000
# SEP-1: KB sources reach the AI service as short-lived signed URLs (the AI holds no storage key).
AI_RAG_STORAGE_SIGNED_URL_TTL_SECONDS=600
# Origin the AI server reaches storage on, when SUPABASE_URL is local to this host (empty = keep it).
# Must match the AI service's AI_RAG_STORAGE_ALLOWED_ORIGINS.
AI_RAG_STORAGE_SIGNED_URL_ORIGIN=
AI_TOKEN_RESERVATION_SECONDS=600
AI_CHAT_TOKEN_RESERVE_ESTIMATE=8000
AI_LESSON_AUTHOR_TOKEN_RESERVE_ESTIMATE=250000
AI_INDEX_TOKEN_RESERVE_ESTIMATE=20000
AI_ENGINE_TRANSITION_WORKER_ENABLED=true
AI_ENGINE_TRANSITION_WORKER_POLL_INTERVAL_MS=15000
AI_ENGINE_TRANSITION_WORKER_BATCH_SIZE=20
AI_ENGINE_TRANSITION_WORKER_LEASE_SECONDS=300
AI_ENGINE_TRANSITION_WORKER_MAX_ATTEMPTS=30
AI_ENGINE_TRANSITION_WORKER_RETRY_BASE_SECONDS=30
AI_ENGINE_TRANSITION_WORKER_RETRY_MAX_SECONDS=3600

# ── Secrets — fill locally, keep blank in Git ──
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SSO_CONFIG_ENCRYPTION_KEY=

# ── Bcrypt ──
BCRYPT_SALT_ROUNDS=12

# ── Public origin — fill locally, keep blank in Git ──
CORS_ORIGIN=

# Normal chatbot model. Kept independent from AI ID rollout and cost policy.
GEMINI_CHAT_MODEL=gemini-3.5-flash

# AI ID / Lesson Author model. Gemini 3.8 requires google-genai >=2.22 in the RAG service.
GEMINI_LESSON_AUTHOR_MODEL=gemini-3.8-flash

# Report PDF export: HTML is printed by an installed Chromium-based browser via
# playwright-core (no browser is downloaded). PATH (absolute executable) wins
# over CHANNEL (msedge | chrome | chromium). Linux/Docker: set PATH explicitly.
REPORT_PDF_BROWSER_PATH=
REPORT_PDF_BROWSER_CHANNEL=msedge
# Renders in parallel per API process, waiting renders, per-render timeout (ms)
# and how long an idle browser stays open (0 = keep open).
REPORT_PDF_RENDER_CONCURRENCY=2
REPORT_PDF_RENDER_QUEUE_LIMIT=20
REPORT_PDF_RENDER_TIMEOUT_MS=30000
REPORT_PDF_BROWSER_IDLE_CLOSE_MS=600000
# Store generated PDFs in Supabase Storage under {tenant}/report-exports/ so
# downloads survive restarts (counts toward the tenant data quota). Off = in-memory job only.
REPORT_PDF_STORAGE_ENABLED=false
# Let Gemini write the PDF narrative from verified facts (uses tenant AI tokens).
# Off = deterministic rule-based narrative.
REPORT_PDF_AI_NARRATIVE_ENABLED=false
REPORT_PDF_AI_NARRATIVE_TIMEOUT_MS=20000
# New exports allowed per user and per tenant in each window (Redis counters).
REPORT_PDF_RATE_LIMIT_WINDOW_SECONDS=600
REPORT_PDF_USER_EXPORTS_PER_WINDOW=10
REPORT_PDF_TENANT_EXPORTS_PER_WINDOW=60
# Exports of one tenant in progress at once per API process (finished exports do not count).
REPORT_PDF_TENANT_ACTIVE_JOBS=5
# Chat report Gemini deadlines (ms): the router then continues with the
# deterministic parser only, the narrative with its rule-based fallback.
REPORT_CHAT_ROUTER_TIMEOUT_MS=8000
REPORT_CHAT_NARRATIVE_TIMEOUT_MS=15000

# Lesson-author video transcription. ffmpeg and ffprobe must be installed and
# available to the PM2 user. Uploaded video and generated transcripts remain
# in the private lesson-author-private Storage bucket until retention expiry.
LESSON_AUTHOR_VIDEO_MAX_UPLOAD_MB=500
LESSON_AUTHOR_VIDEO_MAX_DURATION_SECONDS=10800
LESSON_AUTHOR_TRANSCRIPT_MAX_CHARS=2000000
LESSON_AUTHOR_TRANSCRIPT_RETENTION_HOURS=168
LESSON_AUTHOR_TRANSCRIPTION_WORKER_ENABLED=true
LESSON_AUTHOR_TRANSCRIPTION_WORKER_POLL_INTERVAL_MS=10000
LESSON_AUTHOR_TRANSCRIPTION_WORKER_BATCH_SIZE=2
LESSON_AUTHOR_TRANSCRIPTION_WORKER_CONCURRENCY=1
LESSON_AUTHOR_TRANSCRIPTION_WORKER_LEASE_SECONDS=1800
LESSON_AUTHOR_TRANSCRIPTION_WORKER_MAX_ATTEMPTS=3
LESSON_AUTHOR_TRANSCRIPTION_WORKER_RETRY_BASE_SECONDS=60
LESSON_AUTHOR_TRANSCRIPTION_WORKER_RETRY_MAX_SECONDS=3600
LESSON_AUTHOR_TRANSCRIPTION_TEMP_DIR=./tmp/lesson-author-transcription
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# Optional: public HTTPS origin used only by demo iframe embed URL/bootstrap checks.
# Leave empty to derive from tenant.domain_learner.
DEMO_IFRAME_PUBLIC_ORIGIN=

# Durable self-built-RAG Course Blueprint. Enable only after the two manual SQL
# files, schema/role verification and deployment checks. Requires shared Redis
# admission locking and AI_TOKEN_RESERVATION_SECONDS >= 600 (no TTL increase here).
# Unknown dispatched usage stays reserved pending manual reconciliation.
LESSON_AUTHOR_GENERATION_ENABLED=false
# Server-owned workspace launch switch; also requires
# LESSON_AUTHOR_WORKSPACE_EXECUTION_ENABLED=true. The browser cannot select the
# lane. Dedicated dispatcher/worker roles remain separate explicit processes.
# Keep all flags off until manual SQL, catalog and staging rollout verification.
LESSON_AUTHOR_ORCHESTRATION_V2_ADMISSION_ENABLED=false
LESSON_AUTHOR_ORCHESTRATION_V2_TENANT_CONCURRENCY=16
LESSON_AUTHOR_ORCHESTRATION_V2_WORKSPACE_CONCURRENCY=4
LESSON_AUTHOR_ORCHESTRATION_V2_ENABLED=false
LESSON_AUTHOR_ORCHESTRATION_V2_ROLE=disabled
LESSON_AUTHOR_ORCHESTRATION_V2_LANE_COUNT=1
LESSON_AUTHOR_ORCHESTRATION_V2_LANE_INDEX=0
LESSON_AUTHOR_ORCHESTRATION_V2_OUTBOX_LEASE_SECONDS=30
LESSON_AUTHOR_ORCHESTRATION_V2_OUTBOX_MAX_ATTEMPTS=8
LESSON_AUTHOR_ORCHESTRATION_V2_RETRY_BASE_MS=1000
LESSON_AUTHOR_ORCHESTRATION_V2_RETRY_MAX_MS=60000
LESSON_AUTHOR_ORCHESTRATION_V2_PUBLISHED_RECOVERY_SECONDS=120
LESSON_AUTHOR_ORCHESTRATION_V2_DISPATCH_BATCH_SIZE=25
LESSON_AUTHOR_ORCHESTRATION_V2_RECOVERY_BATCH_SIZE=25
LESSON_AUTHOR_ORCHESTRATION_V2_POLL_INTERVAL_MS=1000
LESSON_AUTHOR_ORCHESTRATION_V2_GLOBAL_CONCURRENCY=64
LESSON_AUTHOR_ORCHESTRATION_V2_PROVIDER_CONCURRENCY=8
LESSON_AUTHOR_ORCHESTRATION_V2_UNIT_SOFT_DEADLINE_MS=45000
LESSON_AUTHOR_ORCHESTRATION_V2_WORKER_LEASE_SECONDS=30
LESSON_AUTHOR_ORCHESTRATION_V2_WORKER_RECOVERY_BATCH_SIZE=25
# AI ID IDM pipeline (admission only). When enabled, new V2 runs of the listed
# tenants (comma-separated UUIDs; empty = every tenant) record the IDM runtime
# hash. Turning it off never re-routes runs that were already admitted.
LESSON_AUTHOR_IDM_PIPELINE_ENABLED=false
LESSON_AUTHOR_IDM_PIPELINE_TENANT_ALLOWLIST=
# IDM unit soft deadline (30000-300000 ms); validated now, used by IDM unit tasks from IDM-4.
LESSON_AUTHOR_IDM_UNIT_SOFT_DEADLINE_MS=120000
# Optional queue override; RABBITMQ_QUEUE_PREFIX is applied when omitted.
LESSON_AUTHOR_ORCHESTRATION_V2_QUEUE=
# Optional durable AI Instructional Design session-deletion queue override.
LESSON_AUTHOR_SESSION_DELETE_QUEUE=
# Optional status-only inspection; generation enabled also enables this GET.
LESSON_AUTHOR_GENERATION_STATUS_ENABLED=false
# Workspace authenticated reads only. Keep off until workspace rollout gates pass.
# This does not enable admission, automatic content generation, Save/Reset or Apply.
LESSON_AUTHOR_WORKSPACE_READ_ENABLED=false
LESSON_AUTHOR_WORKSPACE_STREAM_ENABLED=false
LESSON_AUTHOR_WORKSPACE_STREAM_AUTH_LEASE_MS=300000
# Save/Reset only, also requires READ_ENABLED; does not start workers or enable Apply.
LESSON_AUTHOR_WORKSPACE_EDIT_ENABLED=false
LESSON_AUTHOR_WORKSPACE_EXECUTION_ENABLED=false
# Draft-only workspace Apply. Requires READ + EDIT + EXECUTION and the manual
# workspace execution SQL schema; it never publishes learner-visible blocks.
LESSON_AUTHOR_WORKSPACE_APPLY_ENABLED=false
# CP5 is intentionally default-off. Install and verify the manual SQL before
# enabling; CP6 supplies the reviewer/publish UX.
COURSE_PUBLISH_GOVERNANCE_ENABLED=false
# V5 chapter per-unit checkpoints and explicit continuation. Enable only after
# 20260926_0237_lesson_author_chapter_checkpoints.sql and rollout verification.
# Requires shared Redis admission locking and AI_TOKEN_RESERVATION_SECONDS >= 600.
# Maintenance expires leases/retains unknown-usage holds; it never retries AI.
LESSON_AUTHOR_CHAPTER_CHECKPOINT_ENABLED=false
