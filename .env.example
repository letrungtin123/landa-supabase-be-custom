# ═══════════════════════════════════════════════════════════════
# LANDA Backend — Environment Variables
# Copy file này thành .env rồi điền giá trị
# KHÔNG commit .env vào Git!
# ═══════════════════════════════════════════════════════════════

# ── Server ──
NODE_ENV=development
PORT=3001
TRUST_PROXY_HOPS=0

# ── Protected infrastructure — fill locally, keep blank in Git ──
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RABBITMQ_URL=

# Redis (optional - backend falls back to DB if unavailable)
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=2000
SMTP_TLS_REJECT_UNAUTHORIZED=true
EMAIL_OUTBOX_WORKER_ENABLED=true
EMAIL_OUTBOX_INLINE_WORKER_ENABLED=true
EMAIL_OUTBOX_QUEUE=LANDA_EMAIL_OUTBOX
EMAIL_OUTBOX_INTERVAL_MS=15000
EMAIL_OUTBOX_BATCH_SIZE=25
EMAIL_OUTBOX_CLAIM_BATCH_SIZE=25
EMAIL_OUTBOX_CONCURRENCY=3
EMAIL_OUTBOX_TENANT_CONCURRENCY=2
EMAIL_OUTBOX_TICK_BUDGET_MS=45000
EMAIL_OUTBOX_SESSION_MAX_MESSAGES=20
EMAIL_OUTBOX_SENT_RETENTION_DAYS=30
EMAIL_OUTBOX_RETENTION_BATCH_SIZE=1000
EMAIL_OUTBOX_WAKE_DEBOUNCE_MS=500
EMAIL_OUTBOX_RABBIT_PREFETCH=50
EMAIL_OUTBOX_TENANT_FAILURE_THRESHOLD=3
EMAIL_OUTBOX_TENANT_COOLDOWN_MS=300000
EMAIL_OUTBOX_TENANT_MAX_COOLDOWN_MS=1800000

# Tenant data quota reconciliation. Production uses the dedicated PM2 worker;
# leave false for an API-only local process.
TENANT_DATA_QUOTA_WORKER_ENABLED=false
TENANT_DATA_QUOTA_WORKER_HEARTBEAT_INTERVAL_MS=30000
TENANT_DATA_QUOTA_WORKER_POLL_INTERVAL_MS=15000
TENANT_DATA_QUOTA_WORKER_STANDBY_RETRY_MS=30000
TENANT_DATA_QUOTA_WORKER_PAGE_SIZE=500
TENANT_DATA_QUOTA_WORKER_MAX_TENANTS_PER_CYCLE=1
TENANT_DATA_QUOTA_WORKER_MAX_PAGES_PER_CLAIM=100
TENANT_DATA_QUOTA_WORKER_LEASE_SECONDS=120
TENANT_DATA_QUOTA_WORKER_MAX_SLICE_MS=60000
TENANT_DATA_QUOTA_WORKER_DATABASE_SNAPSHOT_TIMEOUT_MS=600000
TENANT_DATA_QUOTA_WORKER_RETRY_BASE_SECONDS=30
TENANT_DATA_QUOTA_WORKER_RETRY_MAX_SECONDS=3600

# Durable Knowledge Base operation worker. PostgreSQL claims jobs safely when
# more than one backend replica is running; do not run a separate manual job.
KB_OPERATION_WORKER_ENABLED=true
KB_OPERATION_WORKER_POLL_INTERVAL_MS=10000
KB_OPERATION_WORKER_BATCH_SIZE=24
KB_OPERATION_WORKER_CONCURRENCY=4
KB_OPERATION_WORKER_LEASE_SECONDS=300
KB_OPERATION_WORKER_MAX_ATTEMPTS=12
KB_OPERATION_WORKER_RETRY_BASE_SECONDS=30
KB_OPERATION_WORKER_RETRY_MAX_SECONDS=3600
# DB-backed recovery for a committed KB restore whose RabbitMQ message was lost.
KB_RESTORE_RECOVERY_POLL_INTERVAL_MS=30000

# ── Secrets — fill locally, keep blank in Git ──
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SSO_CONFIG_ENCRYPTION_KEY=

# ── Bcrypt ──
BCRYPT_SALT_ROUNDS=12

# ── Public origin — fill locally, keep blank in Git ──
CORS_ORIGIN=

# Gemini chat/content generation model.
# Must support File Search. Use gemini-3.5-flash for new AI Studio auth keys.
GEMINI_CHAT_MODEL=gemini-3.5-flash

# Optional: public HTTPS origin used only by demo iframe embed URL/bootstrap checks.
# Leave empty to derive from tenant.domain_learner.
DEMO_IFRAME_PUBLIC_ORIGIN=
